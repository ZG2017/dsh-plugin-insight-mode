{
  "name": "@gz2016/dsh-plugin-insight-mode",
  "description": "Master/worker deep-research architecture: the top-level agent clarifies your request, gets your approval on a task breakdown and operating budget, then dispatches independent parallel worker subagents until the report is done.",
  "version": "0.2.0",
  "license": "MIT",
  "author": "ZG2017",
  "homepage": "https://github.com/ZG2017/dsh-plugin-insight-mode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZG2017/dsh-plugin-insight-mode.git"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "research", "insight", "subagent", "master-worker"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=lib/index.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
